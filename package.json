{
  "name": "flash-sale",
  "version": "0.1.0",
  "private": true,
  "description": "High-throughput flash sale system: monorepo with Fastify API, React frontend, shared contracts, and a stress-test harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddcmendoza/flash-sale.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:reset": "docker compose -f infra/docker-compose.yml down -v && npm run db:up -s && sh -c 'until docker exec flash-sale-postgres pg_isready -U flash -d flash_sale >/dev/null 2>&1; do sleep 1; done' && npm run db:migrate -s",
    "db:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "db:migrate": "npm run migrate -w @flash-sale/server",
    "dev:server": "npm run dev -w @flash-sale/server",
    "dev:web": "npm run dev -w @flash-sale/web",
    "build:web": "npm run build -w @flash-sale/web",
    "start:web": "npm run preview -w @flash-sale/web",
    "test": "npm run test -w @flash-sale/server",
    "test:watch": "npm run test:watch -w @flash-sale/server",
    "test:e2e": "npm run db:up -s && npm run db:migrate -s && npm run test -w @flash-sale/e2e",
    "e2e:ui": "npm run test:ui -w @flash-sale/e2e",
    "bench": "sh stress/docker/run.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "stress": "sh stress/locust/run.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vitest": "^3.0.0"
  }
}