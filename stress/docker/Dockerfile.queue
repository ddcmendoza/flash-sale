# The flash-sale API server under test, queue write path. Same build as
# stress/docker/Dockerfile (the entire app incl. an in-process BullMQ worker)
# but with PURCHASE_MODE=queue baked in, so the bench harness can be pointed at
# a queue-mode server without thread-hopping env vars per run.
#
# Build context is the repo root (npm workspaces: shared + server).

FROM node:22-bookworm-slim
WORKDIR /app

# tsx (root devDependency) is the server's runtime; the full npm ci links the
# `@flash-sale/shared` workspace too. Workspace manifests must exist before
# install so npm resolves the graph.
COPY package.json package-lock.json .
COPY apps/server/package.json apps/server/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci -s

# Source (no build step for server code; tsx runs it directly).
COPY apps apps
COPY packages packages

# Queue-mode default for this image variant (override at runtime if needed).
ENV PURCHASE_MODE=queue

EXPOSE 3000
USER node
CMD ["npx", "tsx", "apps/server/src/index.ts"]